<Window x:Class="GameGuideApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Guide Premium"
        Width="1580"
        Height="1040"
        Background="#050A1E"
        FontFamily="Segoe UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#060B1F" Offset="0"/>
            <GradientStop Color="#071634" Offset="0.45"/>
            <GradientStop Color="#030611" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#0B1732"/>
            <Setter Property="BorderBrush" Value="#223760"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCE8FF"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#050C1F" BorderBrush="#173057" BorderThickness="0,0,1,0" Padding="20,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Game Guide" FontSize="40" FontWeight="Bold"/>
                    <TextBlock Text="Premium Edition" Foreground="#A05BFF" FontSize="20" Margin="0,2,0,30"/>

                    <Button Content="Übersicht" Height="46" Margin="0,0,0,10" Background="#5B2BD9" BorderBrush="#8855FF" Foreground="White"/>
                    <Button Content="Alle Spiele" Height="46" Margin="0,0,0,10" Background="#0B1732" BorderBrush="#263F6B" Foreground="#BFD1F7"/>
                    <Button Content="Meine Guides" Height="46" Margin="0,0,0,10" Background="#0B1732" BorderBrush="#263F6B" Foreground="#BFD1F7"/>
                    <Button Content="Freigeschaltete Inhalte" Height="46" Margin="0,0,0,10" Background="#0B1732" BorderBrush="#263F6B" Foreground="#BFD1F7"/>
                    <Button Content="Downloads" Height="46" Margin="0,0,0,10" Background="#0B1732" BorderBrush="#263F6B" Foreground="#BFD1F7"/>
                    <Button Content="Favoriten" Height="46" Margin="0,0,0,10" Background="#0B1732" BorderBrush="#263F6B" Foreground="#BFD1F7"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Guido" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Premium" Foreground="#A05BFF"/>
                    <TextBlock Text="Version 1.0.0" Foreground="#8CA4CD" Margin="0,20,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PanelCard}" Height="48" VerticalAlignment="Center" Padding="16,8">
                <DockPanel>
                    <TextBlock Text="🔎" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox Text="Suche nach Spielen oder Guides..." Background="Transparent" BorderThickness="0" Foreground="#8FA9D3" FontSize="17" VerticalContentAlignment="Center"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,10,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Spiele" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <ListBox ItemsSource="{Binding Guides}" Background="Transparent" BorderThickness="0" Foreground="#DCE8FF">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" Background="#111F3F" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding GameName}" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="Action RPG" Foreground="#8AA7D6" FontSize="14"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="0,0,10,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Guides" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <ListBox ItemsSource="{Binding Guides}" SelectedItem="{Binding SelectedGuide}" Background="Transparent" BorderThickness="0" Foreground="#DCE8FF">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" Background="#101B36" BorderBrush="#7B41F8" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Category}" Foreground="#A2BCE6" FontSize="14"/>
                                            <TextBlock Text="FREIGESCHALTET" Foreground="#56E57E" FontSize="13" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedGuide.Title}" FontSize="44" FontWeight="Bold"/>
                            <TextBlock Text="Der perfekte Start in Elden Ring" Foreground="#A9BEE2" FontSize="24" Margin="0,4,0,10"/>
                            <Rectangle Height="260" Fill="#203350" RadiusX="8" RadiusY="8"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="1. Einleitung" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="20" Foreground="#C4D4F1" Text="Willkommen in der Zwischenwelt! Dieser Guide hilft dir, die wichtigsten Grundlagen zu verstehen und optimal zu starten." Margin="0,0,0,16"/>
                            <TextBlock Text="2. Charaktererstellung" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="20" Foreground="#C4D4F1" Text="Wähle eine Klasse, die zu deinem Spielstil passt. Für Anfänger empfehlen wir Vagabund oder Samurai." Margin="0,0,0,16"/>
                            <TextBlock Text="3. Die ersten Schritte" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="• Verlasse die Kapelle und sammle die ersten Items." FontSize="20" Foreground="#C4D4F1"/>
                            <TextBlock Text="• Besiege den ersten Gegner für Runen." FontSize="20" Foreground="#C4D4F1"/>
                            <TextBlock Text="• Aktiviere die Gnade und speichere dein Spiel." FontSize="20" Foreground="#C4D4F1"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
