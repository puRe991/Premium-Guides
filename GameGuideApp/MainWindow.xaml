<Window x:Class="GameGuideApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selectors="clr-namespace:GameGuideApp.Selectors"
        Title="Guide Bibliothek" Width="1600" Height="980" FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate x:Key="HeadingTemplate"><TextBlock Text="{Binding Text}" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Foreground="#18100A" Margin="0,20,0,8"/></DataTemplate>
        <DataTemplate x:Key="ParagraphTemplate"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontFamily="Georgia" FontSize="14" Foreground="#2E2210" Margin="0,0,0,14"/></DataTemplate>
        <DataTemplate x:Key="StepTemplate"><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="18" Height="18" Background="#18100A" CornerRadius="9"><TextBlock Text="{Binding StepNumber}" Foreground="#C8A840" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Margin="8,0,0,0" Text="{Binding Text}" FontFamily="Georgia" FontSize="13" Foreground="#2E2210"/></StackPanel></DataTemplate>
        <DataTemplate x:Key="TipTemplate"><Border BorderBrush="#C8A840" BorderThickness="3,0,0,0" Background="#14C8A840" Padding="10" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding TipLabel}" Foreground="#C8A840" FontSize="9"/><TextBlock Text="{Binding Text}" FontSize="13" Foreground="#4A3A1A"/></StackPanel></Border></DataTemplate>
        <DataTemplate x:Key="MapTemplate"><Border Height="120" BorderBrush="#55000000" BorderThickness="1" Background="#09000000" Margin="0,0,0,12"><TextBlock Text="🗺 Karte" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7A6A4A"/></Border></DataTemplate>
        <selectors:ContentBlockTemplateSelector x:Key="ContentSelector" HeadingTemplate="{StaticResource HeadingTemplate}" ParagraphTemplate="{StaticResource ParagraphTemplate}" StepTemplate="{StaticResource StepTemplate}" TipTemplate="{StaticResource TipTemplate}" MapTemplate="{StaticResource MapTemplate}"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="220"/><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource C0Bg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0" Padding="16"><DockPanel><StackPanel><TextBlock Text="Guide Bibliothek" FontFamily="Georgia" FontSize="18" Foreground="#E8D9B8"/><TextBlock Text="PREMIUM EDITION" FontSize="9" Foreground="#4A5060"/><TextBlock Text="PLATTFORM" FontSize="9" Foreground="#333A47" Margin="0,18,0,8"/><ItemsControl ItemsSource="{Binding Platforms}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource PlatformButton}" Margin="0,0,0,4"><Border BorderThickness="2,0,0,0" BorderBrush="{StaticResource Gold}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}"/><TextBlock Text="{Binding Name}" Margin="8,0,0,0" Foreground="{StaticResource UiTextActive}"/></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Separator Margin="0,14,0,10"/><Button Content="Gespeichert" Style="{StaticResource PlatformButton}"/><Button Content="Zuletzt gelesen" Style="{StaticResource PlatformButton}"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="v1.0.0" Foreground="#3A4050"/></DockPanel></Border>

        <Border Grid.Column="1" Background="{StaticResource C1Bg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Spiele" FontFamily="Georgia" FontSize="14" Foreground="#C8B890"/><TextBox Text="{Binding GameSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,8"/></StackPanel><ListBox ItemsSource="{Binding FilteredGames}" SelectedItem="{Binding SelectedGame}" ItemContainerStyle="{StaticResource DarkListBoxItem}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" Foreground="#6A7484"/><TextBlock Text="{Binding Genre}" FontSize="10" Foreground="#333A47"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>

        <Border Grid.Column="2" Background="{StaticResource C2Bg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding SelectedGame.Name}" FontFamily="Georgia" FontSize="14" Foreground="#C8B890"/><ListBox ItemsSource="{Binding GuidesForSelectedGame}" SelectedItem="{Binding SelectedGuide}" ItemContainerStyle="{StaticResource DarkListBoxItem}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Category}" FontSize="9" Foreground="#333A47"/><TextBlock Text="{Binding Title}" Foreground="#5A6474"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>

        <Grid Grid.Column="3" Background="{StaticResource ParchmentBg}"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{StaticResource ReaderTop}" BorderBrush="#1A000000" BorderThickness="0,0,0,1" Padding="16,8"><DockPanel><TextBlock Text="{Binding BreadcrumbText}" FontSize="11" Foreground="#8A7A5A"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="🔖 Speichern" Command="{Binding SaveGuideCommand}" Margin="8,0,0,0"/><Button Content="↗ Teilen" Command="{Binding ShareGuideCommand}" Margin="8,0,0,0"/></StackPanel></DockPanel></Border><ScrollViewer Grid.Row="1" Style="{StaticResource ReaderScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="40,32,52,56"><StackPanel><StackPanel Orientation="Horizontal"><Border Background="#0F000000" Padding="7,2" CornerRadius="3"><TextBlock Text="{Binding SelectedPlatform.Name}" FontSize="10"/></Border><Border Background="#30B89030" Padding="7,2" CornerRadius="3" Margin="8,0,0,0"><TextBlock Text="{Binding SelectedGuide.Category}" FontSize="10"/></Border></StackPanel><TextBlock Text="{Binding SelectedGuide.Title}" FontFamily="Georgia" FontSize="30" FontWeight="Bold" Foreground="#18100A" Margin="0,16,0,6"/><TextBlock Text="{Binding SelectedGuide.Subtitle}" FontFamily="Georgia" FontStyle="Italic" FontSize="14" Foreground="#6A5A3A" Margin="0,0,0,16"/><Rectangle Height="1" Fill="#C8A840" Margin="0,0,0,22"/><ItemsControl ItemsSource="{Binding ContentBlocks}" ItemTemplateSelector="{StaticResource ContentSelector}" MaxWidth="600"/></StackPanel></ScrollViewer></Grid>
    </Grid>
</Window>
