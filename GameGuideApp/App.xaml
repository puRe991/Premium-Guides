<Application x:Class="GameGuideApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:selectors="clr-namespace:GameGuideApp.Selectors">
    <Application.Resources>
        <SolidColorBrush x:Key="C0Bg" Color="#070A0E"/>
        <SolidColorBrush x:Key="C1Bg" Color="#0C1018"/>
        <SolidColorBrush x:Key="C2Bg" Color="#0A0E14"/>
        <SolidColorBrush x:Key="ParchmentBg" Color="#F5F0E4"/>
        <SolidColorBrush x:Key="ReaderTop" Color="#EDE7D5"/>
        <SolidColorBrush x:Key="BorderDark" Color="#1A2030"/>
        <SolidColorBrush x:Key="Gold" Color="#C8AA64"/>
        <SolidColorBrush x:Key="UiText" Color="#4A5464"/>
        <SolidColorBrush x:Key="UiTextActive" Color="#D4B87A"/>

        <Style x:Key="DarkListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0DFFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#15C8AA64"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="PlatformButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar"><Setter Property="Width" Value="4"/></Style>
        <Style x:Key="ReaderScrollViewer" TargetType="ScrollViewer"></Style>
    </Application.Resources>
</Application>
